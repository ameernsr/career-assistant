# Copy to .env and fill in. Never commit .env.
OPENAI_BASE_URL=https://your-gateway.example.com/v1
OPENAI_API_KEY=sk-your-team-key
CHAT_MODEL=gpt-5.4-mini
EMBED_MODEL=text-embedding-3-small
