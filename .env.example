# Copy to .env and fill in. Never commit .env.
OPENAI_BASE_URL=https://your-gateway.example.com/v1
OPENAI_API_KEY=sk-your-team-key
CHAT_MODEL=gpt-5.4-mini
EMBED_MODEL=text-embedding-3-small
STT_MODEL=gpt-transcribe
TTS_MODEL=gpt-4o-mini-tts
SESSION_BUDGET_USD=0.50
# USD per 1M tokens [input, output] or per audio second. Chat: docs.metisai.ir/pricing; embedding & TTS: OpenAI list price; STT: OpenRouter list price (2026-10-29)
MODEL_PRICES={"gpt-5.4-mini": [0.8625, 5.175], "gpt-4.1-mini": [0.44, 1.76], "text-embedding-3-small": [0.02, 0], "gpt-transcribe": {"per_second": 0.000075}, "gpt-4o-mini-tts": [0.6, 12]}
